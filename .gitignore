# --- Build output -----------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper writes this on first run
.mvn/wrapper/maven-wrapper.properties.bak

# --- Java / JVM -------------------------------------------------------------
*.class
*.jar
*.war
*.ear
*.nar
!**/src/**/*.jar
hs_err_pid*
replay_pid*
*.hprof

# --- IDEs -------------------------------------------------------------------
# IntelliJ: project files reference local SDK names and module paths, so they
# are not portable between machines. Delete this line and keep IntelliJ's own
# .idea/.gitignore if you want to share run configurations and code style.
.idea/
*.iml
*.iws
*.ipr

# Eclipse / STS
.classpath
.project
.settings/
.apt_generated/
.factorypath
bin/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
.nb-gradle/

# --- Local configuration and secrets ----------------------------------------
# Anything ending in -local or .local is machine-specific by convention.
*.env
.env
.env.*
!.env.example
**/application-local.yml
**/application-local.yaml
**/application-local.properties
**/*-local.yml
docker-compose.override.yml
*.pem
*.key
*.p12
*.jks
!src/test/resources/**/*.jks

# --- Runtime output ---------------------------------------------------------
logs/
*.log
*.log.gz
/data/
/pgdata/

# --- Test and performance artefacts -----------------------------------------
# Gatling writes a timestamped report directory per run (Phase 8).
**/target/gatling/
**/results/
.gatling/

# Surefire/Failsafe crash dumps
**/*.dumpstream

# PIT mutation testing reports
**/target/pit-reports/

# JaCoCo
*.exec

# --- Kubernetes / Helm ------------------------------------------------------
# Rendered manifests and chart dependencies are build products, not sources.
charts/**/charts/
charts/**/Chart.lock
kubeconfig
*.kubeconfig
rendered/

# --- OS ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Tooling ----------------------------------------------------------------
.claude/settings.local.json
